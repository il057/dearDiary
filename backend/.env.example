# 默认对接本地 Ollama 服务 (免 Key)
LLM_API_KEY=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=llama3.2

# 向量嵌入配置：使用本地 Qwen3-Embedding-0.6B (1024 维)
EMBEDDING_API_KEY=ollama
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=qwen3-embedding:0.6b
EMBEDDING_DIM=1024

# 服务监听配置
HOST=0.0.0.0
PORT=8000
